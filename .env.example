# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EVOLUTION_API_URL: Base URL da sua instancia Evolution API v2 (ex.: https://api.seudominio.com)
EVOLUTION_API_URL="https://sua-evolution-api.com"

# EVOLUTION_API_KEY: Chave global ou da instancia Evolution API (mantida apenas no servidor)
EVOLUTION_API_KEY="SUA_CHAVE_EVOLUTION"

# EVOLUTION_INSTANCE_NAME: Nome padrao da instancia WhatsApp conectada
EVOLUTION_INSTANCE_NAME="casa-do-tempero"

# OPENAI_API_KEY: Chave da API OpenAI para atendimento em linguagem natural estilo Brendi (apenas servidor)
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_MODEL: Modelo OpenAI usado pelo assistente de delivery
OPENAI_MODEL="gpt-4o-mini"
